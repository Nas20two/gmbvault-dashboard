# Auth — DASHBOARD_PASSWORD is the plain password; hash it with bcrypt:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'yourpassword'
DASHBOARD_PASSWORD_HASH=your-bcrypt-hash-here
JWT_SECRET=a-long-random-secret

# MCP (Agentic Inbox) — Phase 1.2. Name per SATORI §1 (NOT "Authorization").
# ⚠️ The real INBOX_ACCESS_CLIENT_ID / _CLIENT_SECRET that were committed here
# earlier have been rotated/blanked. Paste your own values below; never commit
# real credentials to .env.example.
INBOX_MCP_URL=https://inbox.nasyhub.com/mcp
INBOX_ACCESS_CLIENT_ID=<paste-your-client-id-here>
INBOX_ACCESS_CLIENT_SECRET=<paste-your-client-secret-here>

# Upstash Redis (pipeline writes + open tracking). Free tier: 10k ops/day.
# Create a database at https://console.upstash.com, copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
